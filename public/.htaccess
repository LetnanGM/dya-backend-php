Options -Indexes
DirectoryIndex index.php
RewriteEngine On

RewriteRule ^member/?$ member/members.php [L,QSA]
RewriteRule ^member/([a-zA-Z0-9_-]+)/?$ member/members.php?username=$1 [L,QSA]

RewriteRule ^app/login?$ app/login.php [L,QSA]
RewriteRule ^app/register?$ app/register.php [L,QSA]
RewriteRule ^app/dashboard?$ app/dashboard.php [L,QSA]


<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>