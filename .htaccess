RewriteEngine On

# Jangan rewrite jika request sudah menuju public
# RewriteRule ^public/ - [L]

# Jika file/folder tersedia di root, biarkan
# RewriteCond %{REQUEST_FILENAME} -f [OR]
# RewriteCond %{REQUEST_FILENAME} -d
# RewriteRule ^ - [L]

# Arahkan seluruh request ke public/
RewriteRule ^(.*)$ public/$1 [L,QSA]